<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Agun Bazar UI</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#eef2f8;
padding-bottom:90px;
}

/* Header */

.header{
background:#fff;
display:flex;
justify-content:space-between;
align-items:center;
padding:12px;
box-shadow:0 2px 6px rgba(0,0,0,.1);
position:sticky;
top:0;
z-index:100;
}

.logo{
font-size:28px;
font-weight:bold;
color:#d42b2b;
}

.balance{
background:#ff4d1c;
color:#fff;
padding:10px 20px;
border-radius:25px;
font-weight:bold;
}

.profile img{
width:45px;
height:45px;
border-radius:50%;
}

/* Section */

.section-title{
text-align:center;
font-size:34px;
font-weight:bold;
color:#234;
margin:20px 0;
}

.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
padding:0 15px;
}

.card{
background:white;
border-radius:12px;
overflow:hidden;
text-align:center;
box-shadow:0 2px 8px rgba(0,0,0,.08);
padding-bottom:10px;
}

.card img{
width:100%;
height:100px;
object-fit:cover;
}

.card p{
padding:8px;
font-size:15px;
font-weight:600;
}

/* Floating Call */

.call-btn{
position:fixed;
right:18px;
bottom:95px;
width:60px;
height:60px;
background:#ff3c2e;
border-radius:50%;
display:flex;
justify-content:center;
align-items:center;
color:#fff;
font-size:28px;
box-shadow:0 5px 10px rgba(0,0,0,.3);
}

/* Bottom Navigation */

.bottom-nav{
position:fixed;
bottom:0;
left:0;
width:100%;
height:72px;
background:#fff;
display:flex;
justify-content:space-around;
align-items:center;
box-shadow:0 -2px 8px rgba(0,0,0,.15);
}

.bottom-nav .item{
text-align:center;
color:#555;
font-size:13px;
}

.bottom-nav i{
font-size:24px;
margin-bottom:4px;
display:block;
}

.add-btn{
width:65px;
height:65px;
background:#ff4d1c;
border-radius:50%;
display:flex;
justify-content:center;
align-items:center;
color:#fff;
font-size:32px;
margin-top:-35px;
border:5px solid #eef2f8;
}
</style>

</head>
<body>

<div class="header">
<div class="logo">🔥 AGUN BAZAR</div>

<div class="balance">
<i class="fa-solid fa-wallet"></i> 15৳
</div>

<div class="profile">
<img src="https://i.pravatar.cc/100" alt="">
</div>
</div>

<h2 class="section-title">Special Offers</h2>

<div class="grid">

<div class="card">
<img src="https://via.placeholder.com/150x100/5736b6/ffffff?text=SPIN">
<p>Free Offer</p>
</div>

<div class="card">
<img src="https://via.placeholder.com/150x100/5736b6/ffffff?text=AIRDROP">
<p>ID Password</p>
</div>

</div>

<h2 class="section-title">Top Up</h2>

<div class="grid">

<div class="card">
<img src="https://via.placeholder.com/150x100/673ab7/ffffff?text=FF">
<p>FF TopUp [BD]</p>
</div>

<div class="card">
<img src="https://via.placeholder.com/150x100/673ab7/ffffff?text=PASS">
<p>Level Up Pass</p>
</div>

<div class="card">
<img src="https://via.placeholder.com/150x100/673ab7/ffffff?text=VIP">
<p>Weekly Offer</p>
</div>

<div class="card">
<img src="https://via.placeholder.com/150x100/673ab7/ffffff?text=LITE">
<p>Weekly Lite</p>
</div>

<div class="card">
<img src="https://via.placeholder.com/150x100/673ab7/ffffff?text=LIKE">
<p>FF Like</p>
</div>

<div class="card">
<img src="https://via.placeholder.com/150x100/673ab7/ffffff?text=SERVER">
<p>Indonesia Server</p>
</div>

</div>

<div class="call-btn">
<i class="fa-solid fa-phone"></i>
</div>

<div class="bottom-nav">

<div class="item">
<i class="fa-solid fa-house"></i>
Home
</div>

<div class="item">
<i class="fa-solid fa-box"></i>
Orders
</div>

<div class="add-btn">
<i class="fa-solid fa-plus"></i>
</div>

<div class="item">
<i class="fa-solid fa-ticket"></i>
Codes
</div>

<div class="item">
<i class="fa-solid fa-user"></i>
Account
</div>

</div>

</body>
</html>
