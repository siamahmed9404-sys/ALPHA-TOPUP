<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FreshMart</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f4f4f4;
}

header{
background:#0a8f3d;
color:white;
padding:15px 8%;
display:flex;
justify-content:space-between;
align-items:center;
}

.logo{
font-size:28px;
font-weight:bold;
}

nav a{
color:white;
text-decoration:none;
margin-left:20px;
font-weight:bold;
}

.search{
padding:30px 8%;
background:white;
}

.search input{
width:100%;
padding:15px;
font-size:18px;
border:2px solid #0a8f3d;
border-radius:8px;
}

.hero{
background:linear-gradient(90deg,#0a8f3d,#2ecc71);
padding:80px 8%;
color:white;
text-align:center;
}

.hero h1{
font-size:48px;
}

.hero p{
margin-top:15px;
font-size:20px;
}

.hero button{
margin-top:25px;
padding:14px 35px;
background:#fff;
color:#0a8f3d;
border:none;
border-radius:8px;
font-size:18px;
cursor:pointer;
}

.section{
padding:50px 8%;
}

.section h2{
margin-bottom:25px;
}

.categories{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
gap:20px;
}

.category{
background:white;
padding:25px;
border-radius:10px;
text-align:center;
box-shadow:0 3px 10px rgba(0,0,0,.1);
}

.products{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-top:20px;
}

.product{
background:white;
padding:20px;
border-radius:10px;
text-align:center;
box-shadow:0 3px 10px rgba(0,0,0,.1);
